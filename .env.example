# ==============================================================================
# HostelOps Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT SELECTOR (Frontend - Vite)
# ------------------------------------------------------------------------------
# Set to 'development' in Google AI Studio or local dev.
# Set to 'production' in Netlify environment variables.
# If omitted or any value other than 'production', app defaults to 'development' mode (local/mock store).
VITE_APP_ENV="development"

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Frontend - Vite)
# ------------------------------------------------------------------------------
# Required ONLY in production (or when testing real Supabase in dev).
# In development mode, mock in-memory data is used if these are absent.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# SERVER-SIDE ONLY SECRETS (Netlify Functions / Backend)
# ------------------------------------------------------------------------------
# DO NOT prefix with VITE_. These are strictly server-side environment variables
# configured in the Netlify Dashboard under Site Configuration > Environment Variables.
GEMINI_API_KEY="your-gemini-api-key"
